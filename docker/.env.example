# Copy this file to .env (dev/staging) or .env.production and fill in real values.
# Never commit the filled-in .env files.

# --- Database ---
DB_NAME=daftech_crm
DB_USER=daftech
DB_PASSWORD=change_me

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Staging

# --- Auth: JWT signing key for access tokens — REQUIRED, 32+ bytes.
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- CORS / frontend origin the API should accept ---
FRONTEND_ORIGIN=http://localhost:4200
