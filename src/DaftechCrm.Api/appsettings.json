{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=daftech_crm;Username=postgres;Password=CHANGE_ME;SSL Mode=Disable;"
  },
  "TicketWorkflow": {
    "MinimumSatisfactionScore": 90,
    "ClientConfirmationWindowDays": 5
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "CHANGE_ME",
    "Password": "CHANGE_ME",
    "FromAddress": "no-reply@daftech.et",
    "FromName": "DAFTECH CRM"
  },
  "Session": {
    "OfflineAfterMinutes": 5
  },
  "AiReporting": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "claude-sonnet-5",
    "ApiBaseUrl": "https://api.anthropic.com/v1/messages",
    "TimeoutSeconds": 20
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "/files",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  }
}