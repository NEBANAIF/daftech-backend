{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "crm.daftech.et;www.crm.daftech.et",
  "ConnectionStrings": {
    "Postgres": "Host=${DB_HOST};Port=5432;Database=daftech_crm;Username=${DB_USER};Password=${DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://crm.daftech.et"
    ]
  },
  "Jwt": {
    "Issuer": "DaftechCrm",
    "Audience": "DaftechCrmClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "/var/daftech/uploads",
    "PublicBaseUrl": "/files",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  },
  "Smtp": {
    "Host": "smtp.daftech.et",
    "Port": 587,
    "UseStartTls": true,
    "FromAddress": "no-reply@daftech.et",
    "FromName": "DAFTECH CRM"
  },
  "AiReporting": {
    "Enabled": false,
    "Model": "claude-sonnet-5",
    "ApiBaseUrl": "https://api.anthropic.com/v1/messages",
    "TimeoutSeconds": 20
  }
}